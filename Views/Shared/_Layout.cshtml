@{
    var appName = "Quran Video Generation";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E9TBSX38VW"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-E9TBSX38VW');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* <title>@ViewData["Title"] - @appName</title> *@
    <title>Quran Video Generator | توليد مقاطع فيديو للقرآن</title>

    <!-- Canonical -->
    <link rel="canonical" href="https://vidgenipro.com/" />

    <!-- Primary Meta (Bilingual) -->
    <meta name="title" content="Quran Video Generator | توليد مقاطع فيديو للقرآن" />
    <meta name="description" content="Generate beautiful Qur’an videos with recitation and synced ayah overlays — perfect for Shorts, Reels, and Stories. أنشئ مقاطع فيديو جميلة للقرآن الكريم مع التلاوة ونصوص الآيات المتزامنة، والمناسبة للريلز والستوري ويوتيوب شورتس." />
    <meta name="keywords" content="Quran video generator, Qur’an recitation, ayah overlay, Islamic shorts, TikTok Quran, Reels Quran, 9:16 video, توليد فيديو القرآن, تلاوة القرآن, نصوص الآيات, فيديوهات إسلامية, مقاطع قصيرة, ريلز, ستوري" />
    <meta name="author" content="Quran Video Generator" />
    <meta name="language" content="en,ar" />
    <meta http-equiv="Content-Language" content="en, ar" />
    <meta name="robots" content="index, generations, follow" />
    <meta name="theme-color" content="#0b8f3c" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quran Video Generator" />
    <meta property="og:url" content="https://vidgenipro.com/" />
    <meta property="og:title" content="Quran Video Generator | توليد مقاطع فيديو للقرآن" />
    <meta property="og:description" content="Generate beautiful Qur’an videos with recitation and synced ayah overlays — perfect for Shorts, Reels, and Stories. أنشئ مقاطع فيديو جميلة للقرآن الكريم مع التلاوة ونصوص الآيات المتزامنة." />
    <meta property="og:image" content="https://vidgenipro.com/images/og/qvg-preview.jpg" />
    <meta property="og:image:alt" content="Qur’an video generator preview | مُولِّد فيديوهات القرآن" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ar_AR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YOUR_TWITTER_HANDLE" />
    <meta name="twitter:url" content="https://vidgenipro.com/" />
    <meta name="twitter:title" content="Quran Video Generator | توليد مقاطع فيديو للقرآن" />
    <meta name="twitter:description" content="Generate beautiful Qur’an videos with recitation and synced ayah overlays. أنشئ مقاطع فيديو جميلة للقرآن الكريم بنصوص آيات متزامنة." />
    <meta name="twitter:image" content="https://vidgenipro.com/images/og/qvg-preview.jpg" />
    <meta name="twitter:image:alt" content="Qur’an video generator preview | مُولِّد فيديوهات القرآن" />

    <!-- hreflang (bilingual targeting) -->
    <link rel="alternate" hreflang="en" href="https://vidgenipro.com/" />
    <link rel="alternate" hreflang="ar" href="https://vidgenipro.com/ar" />
    <link rel="alternate" hreflang="x-default" href="https://vidgenipro.com/" />

    <!-- JSON-LD (Structured Data) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Quran Video Generator",
        "alternateName": "مولد مقاطع فيديو القرآن",
        "url": "https://vidgenipro.com",
        "description": "Generate beautiful Qur’an videos with recitation and synced ayah overlays — perfect for Shorts, Reels, and Stories. أنشئ مقاطع فيديو جميلة للقرآن الكريم مع التلاوة ونصوص الآيات المتزامنة.",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "Any",
        "image": "https://vidgenipro.com/images/og/qvg-preview.jpg",
        "inLanguage": ["en","ar"],
        "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "publisher": {
        "@type": "Individual",
        "name": "Mostafa Wahbi",
        "url": "https://mwahbi.online",
        "logo": "https://vidgenipro.com/images/logo.svg"
        }
    }
    </script>

    <!-- Icons & PWA (optional but recommended) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    @* <link rel="manifest" href="/site.webmanifest" /> *@

    <!-- Performance (optional) -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.pexels.com" />
    <link rel="dns-prefetch" href="https://api.pexels.com" />

    @RenderSection("Head", required: false)

    <!-- Bootstrap 5.3 from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          crossorigin="anonymous" />

    <!-- Your site styles (after Bootstrap) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top qvg-navbar navbar-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.svg" alt="Logo" class="qvg-logo" />
                <span class="fw-bold">@appName</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#qvgNav"
                    aria-controls="qvgNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="qvgNav">
                <ul class="navbar-nav qvg-nav-links mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    @* <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li> *@
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    @* <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li> *@
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact Us</a></li>

                    <li class="nav-item"><a class="nav-link" asp-controller="Generations" asp-action="Index">Generations</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Bootstrap Bundle JS (Popper included) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    <!-- Cloudflare Turnstile for Captcha (Human Check) -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <!-- Your site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
