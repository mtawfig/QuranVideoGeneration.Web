const reciterSel = document.getElementById('reciter');
const surahSel = document.getElementById('surah');
const fromAyah  = document.getElementById('fromAyah');
const toAyah    = document.getElementById('toAyah');
const ayahCountEl = document.getElementById('surahAyahCount');
const stylehSel = document.getElementById('VideoStyle');

// Load reciters list
fetch('/data/reciters.json')
  .then(r => r.json())
  .then(list => {
    reciterSel.innerHTML = '';
    const ph = new Option('Choose the reciter || حدد القارئ', '', true, true);
    ph.disabled = true; ph.hidden = true; reciterSel.add(ph);
    list.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.Code;
        //opt.textContent = item.DisplayName + ' || ' + item.DisplayNameAR;
        opt.textContent = item.DisplayName;
        reciterSel.appendChild(opt);
    });
  });

// Load surah list
fetch('/data/surah-list.json')
  .then(r => r.json())
  .then(list => {
    surahSel.innerHTML = '';
    const ph = new Option('Choose surah || حدد السورة', '', true, true);
    ph.disabled = true; ph.hidden = true; surahSel.add(ph);

    list.forEach(item => {
      const opt = new Option(
        `${item.index} — ${item.name} || ${item.name_ar} (Ayahs ${item.ayahs} اياتها)`,
        item.index
      );
      opt.dataset.ayahs = item.ayahs;       // <-- keep the count here
      surahSel.add(opt);
    });

    // initialize bounds once (will also run on change)
    applySurahBounds();
  });

// Fill video styles
fetch('/data/video-styles.json')
  .then(r => r.json())
  .then(list => {
    stylehSel.innerHTML = '';
    const ph = new Option('Choose video type || حدد نوع الفيديو', '', true, true);
    ph.disabled = true; ph.hidden = true; stylehSel.add(ph);
    list.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.value;
        opt.textContent = item.name;
        stylehSel.appendChild(opt);
    });
  });

  // Keep ayah bounds in range
/* Clamp helpers */
function clamp(n, min, max){
  n = parseInt(n, 10);
  if (isNaN(n)) n = min;
  return Math.max(min, Math.min(max, n));
}

/* Set min/max for from/to based on selected surah and fix current values */
function applySurahBounds() {
  const opt = surahSel.selectedOptions[0];
  const max = opt ? parseInt(opt.dataset.ayahs, 10) || 286 : 286;

  fromAyah.min = 1; fromAyah.max = max;
  toAyah.min   = 1; toAyah.max   = max;

  let f = clamp(fromAyah.value || 1, 1, max);
  let t = clamp(toAyah.value   || max, 1, max);

  if (t < f) t = f;                 // enforce from ≤ to

  fromAyah.value = String(f);
  toAyah.value   = String(t);

  if (ayahCountEl) ayahCountEl.textContent = max;

  console.log(`Surah ${opt.value} has ${max} ayahs. from=${f}, to=${t}`);
}

surahSel.addEventListener('change', applySurahBounds);

/* Keep the constraint live while typing */
fromAyah.addEventListener('input', () => {
  const max = parseInt(surahSel.selectedOptions[0]?.dataset.ayahs || '286', 10);
  let f = clamp(fromAyah.value, 1, max);
  fromAyah.value = String(f);
  if (parseInt(toAyah.value || '1', 10) < f) toAyah.value = String(f);
});

toAyah.addEventListener('input', () => {
  const max = parseInt(surahSel.selectedOptions[0]?.dataset.ayahs || '286', 10);
  let t = clamp(toAyah.value, 1, max);
  toAyah.value = String(t);
  const f = parseInt(fromAyah.value || '1', 10);
  if (t < f) toAyah.value = String(f);
});

</script>
}
